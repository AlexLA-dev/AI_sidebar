{
  "name": "contextflow",
  "displayName": "ContextFlow",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "AI assistant for the page you are reading — Safari Web Extension for iPhone, iPad and Mac",
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "build:chrome": "node scripts/build-extension.mjs --target=chrome",
    "watch": "node scripts/build-extension.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p netlify/tsconfig.json",
    "test": "node --test --experimental-strip-types --no-warnings 'tests/**/*.test.mts'",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.93.2",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@netlify/functions": "^5.1.2",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.10",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.28.0"
}
