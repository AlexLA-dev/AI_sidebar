    "Only the chats from this device are here. Turn on sync to see your chats from iPhone, iPad and Mac in one place.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier sind nur die Chats von diesem Gerät. Schalte die Synchronisierung ein, um deine Chats von iPhone, iPad und Mac an einem Ort zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí solo están los chats de este dispositivo. Activa la sincronización para ver tus chats del iPhone, el iPad y el Mac en un solo lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les discussions de cet appareil sont ici. Activez la synchronisation pour retrouver celles de l’iPhone, de l’iPad et du Mac au même endroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui ci sono solo le chat di questo dispositivo. Attiva la sincronizzazione per vedere le chat di iPhone, iPad e Mac in un unico posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにはこのデバイスのチャットだけが表示されます。同期をオンにすると、iPhone、iPad、Mac のチャットをまとめて見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 채팅만 여기에 있어요. 동기화를 켜면 iPhone, iPad, Mac의 채팅을 한곳에서 볼 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui estão só as conversas deste dispositivo. Ative a sincronização para ver as conversas do iPhone, iPad e Mac em um só lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь только чаты с этого устройства. Включите синхронизацию, чтобы видеть чаты с iPhone, iPad и Mac в одном месте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут лише чати з цього пристрою. Увімкніть синхронізацію, щоб бачити чати з iPhone, iPad і Mac в одному місці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只有本设备上的对话。打开同步，即可在一处查看 iPhone、iPad 和 Mac 上的对话。"
          }
        }
      }
