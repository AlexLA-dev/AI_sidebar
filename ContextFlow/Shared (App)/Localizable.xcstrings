    "This week's %lld minutes of listening are used up. They come back on %@. Apple's voice reads the rest.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت دقائق الاستماع لهذا الأسبوع (%lld دقيقة). تعود يوم %@. ويقرأ صوت Apple الباقي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %lld Minuten Anhören für diese Woche sind aufgebraucht. Am %@ gibt es neue. Den Rest liest die Stimme von Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se acabaron los %lld minutos de escucha de esta semana. Vuelven el %@. El resto lo lee la voz de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld minutes d’écoute de la semaine sont épuisées. Elles reviennent %@. La voix d’Apple lit la suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I %lld minuti di ascolto di questa settimana sono finiti. Tornano %@. Il resto lo legge la voce di Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週の読み上げ%lld分を使い切りました。%@に戻ります。残りは Apple の音声で読み上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 듣기 %lld분을 모두 사용했어요. %@에 다시 채워져요. 나머지는 Apple 음성으로 읽어 드려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os %lld minutos para ouvir desta semana acabaram. Eles voltam %@. O resto é lido pela voz da Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минуты прослушивания на эту неделю закончились (%lld мин). Обновятся: %@. Остальное прочитает голос Apple."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хвилини прослуховування на цей тиждень закінчилися (%lld хв). Оновляться: %@. Решту прочитає голос Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã dùng hết %lld phút nghe của tuần này. Sẽ có lại vào %@. Phần còn lại sẽ do giọng của Apple đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周的 %lld 分钟朗读时长已用完，%@恢复。其余部分由 Apple 的语音朗读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這週的 %lld 分鐘朗讀時間已用完，%@會恢復。其餘部分由 Apple 的語音朗讀。"
          }
        }
      }
    },
    "No connection to ContextFlow: Apple's voice reads the rest.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال بـ ContextFlow: يقرأ صوت Apple الباقي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung zu ContextFlow: Den Rest liest die Stimme von Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión con ContextFlow: el resto lo lee la voz de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion à ContextFlow : la voix d’Apple lit la suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione a ContextFlow: il resto lo legge la voce di Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlow に接続できません。残りは Apple の音声で読み上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlow에 연결할 수 없어요. 나머지는 Apple 음성으로 읽어 드려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão com o ContextFlow: o resto é lido pela voz da Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет связи с ContextFlow: остальное прочитает голос Apple."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає зв’язку з ContextFlow: решту прочитає голос Apple."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không kết nối được với ContextFlow: phần còn lại sẽ do giọng của Apple đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 ContextFlow：其余部分由 Apple 的语音朗读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到 ContextFlow：其餘部分由 Apple 的語音朗讀。"
          }
        }
      }
    },
    "Cheap flights to Lisbon in May?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذاكر رخيصة إلى لشبونة في مايو؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Günstige Flüge nach Lissabon im Mai?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Vuelos baratos a Lisboa en mayo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vols pas chers pour Lisbonne en mai ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voli economici per Lisbona a maggio?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5月のリスボン行き格安航空券は？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5월 리스본 저렴한 항공권?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voos baratos para Lisboa em maio?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дешёвые билеты в Лиссабон на май?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дешеві квитки до Лісабона на травень?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vé máy bay giá rẻ đi Lisbon tháng 5?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五月去里斯本的便宜机票？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五月去里斯本的便宜機票？"
          }
        }
      }
    },
    "In May, return flights from Berlin to Lisbon start at about 90 euros. It's best to book six to eight weeks ahead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في مايو تبدأ تذاكر الذهاب والعودة من برلين إلى لشبونة من نحو 90 يورو. الأفضل الحجز قبل ستة إلى ثمانية أسابيع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Mai gibt es Hin- und Rückflüge von Berlin nach Lissabon ab etwa 90 Euro. Am besten sechs bis acht Wochen vorher buchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En mayo, los vuelos de ida y vuelta de Berlín a Lisboa cuestan desde unos 90 euros. Conviene reservar con seis a ocho semanas de antelación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mai, les allers-retours Berlin–Lisbonne commencent vers 90 euros. Mieux vaut réserver six à huit semaines à l'avance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A maggio i voli andata e ritorno da Berlino a Lisbona partono da circa 90 euro. Meglio prenotare sei-otto settimane prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5月のベルリン〜リスボン往復は約90ユーロから。6〜8週間前の予約がおすすめです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5월 베를린–리스본 왕복 항공권은 약 90유로부터입니다. 6~8주 전에 예약하는 것이 좋아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em maio, voos de ida e volta de Berlim a Lisboa saem a partir de uns 90 euros. O ideal é reservar com seis a oito semanas de antecedência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В мае билеты из Берлина в Лиссабон и обратно — примерно от 90 евро. Лучше брать за шесть–восемь недель."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У травні квитки з Берліна до Лісабона й назад — приблизно від 90 євро. Краще купувати за шість–вісім тижнів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tháng 5, vé khứ hồi Berlin – Lisbon chỉ từ khoảng 90 euro. Nên đặt trước sáu đến tám tuần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五月从柏林到里斯本的往返机票约 90 欧元起，最好提前六到八周预订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五月從柏林到里斯本的來回機票約 90 歐元起，最好提前六到八週訂票。"
          }
        }
      }
    },
