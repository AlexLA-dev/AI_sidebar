    "Open Safari Settings → Extensions, tick ContextFlow and allow it on all websites.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Safari-Einstellungen → „Erweiterungen“, aktiviere ContextFlow und erlaube es auf allen Websites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes de Safari → Extensiones, marca ContextFlow y permítelo en todos los sitios web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez les Réglages de Safari → Extensions, cochez ContextFlow et autorisez-le sur tous les sites web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Impostazioni di Safari → Estensioni, seleziona ContextFlow e consentilo su tutti i siti web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariの設定 →「機能拡張」を開き、ContextFlowにチェックを入れて、すべてのWebサイトで許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 설정 → 확장 프로그램을 열고 ContextFlow를 선택한 다음 모든 웹 사이트에서 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Ajustes do Safari → Extensões, marque ContextFlow e permita-o em todos os sites."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте настройки Safari → «Расширения», установите флажок ContextFlow и разрешите расширение на всех веб-сайтах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте параметри Safari → «Розширення», позначте ContextFlow і дозвольте його на всіх вебсайтах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Safari 设置 →“扩展”，勾选 ContextFlow，并允许它在所有网站上运行。"
          }
        }
      }
    },
