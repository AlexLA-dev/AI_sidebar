    "Open any page and tap ✦ — or choose ContextFlow in the page menu of the address bar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح أي صفحة واضغط على ✦، أو اختر ContextFlow من قائمة الصفحة في شريط العناوين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine beliebige Seite und tippe auf ✦ – oder wähle ContextFlow im Seitenmenü der Adressleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre cualquier página y toca ✦, o elige ContextFlow en el menú de la página en la barra de direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une page et touchez ✦, ou choisissez ContextFlow dans le menu de la page de la barre d’adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri una pagina qualsiasi e tocca ✦, oppure scegli ContextFlow nel menu della pagina nella barra degli indirizzi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意のページを開いて✦をタップするか、アドレスバーのページメニューからContextFlowを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 페이지나 열고 ✦를 탭하거나 주소 막대의 페이지 메뉴에서 ContextFlow를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra qualquer página e toque em ✦, ou escolha ContextFlow no menu da página na barra de endereço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте любую страницу и нажмите ✦ — или выберите ContextFlow в меню страницы в адресной строке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте будь-яку сторінку й торкніться ✦ — або виберіть ContextFlow у меню сторінки в адресному рядку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở một trang bất kỳ và chạm vào ✦, hoặc chọn ContextFlow trong menu trang trên thanh địa chỉ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开任意网页并轻点 ✦，或在地址栏的网页菜单中选择 ContextFlow。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開任何頁面並點一下 ✦，或在網址列的頁面選單中選擇「ContextFlow」。"
          }
        }
      }
    },
    "Settings, Apps, Safari, Extensions, ContextFlow: Allow Extension on, All Websites: Allow.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإعدادات، التطبيقات، Safari، الامتدادات، ContextFlow: السماح بالامتداد مشغّل، كل مواقع الويب: سماح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen, Apps, Safari, Erweiterungen, ContextFlow: „Erweiterung erlauben“ ein, „Alle Websites“: Erlauben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes, Apps, Safari, Extensiones, ContextFlow: Permitir extensión activado, Todos los sitios web: Permitir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages, Apps, Safari, Extensions, ContextFlow : Autoriser l’extension activé, Tous les sites web : Autoriser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni, App, Safari, Estensioni, ContextFlow: Consenti estensione attivo, Tutti i siti web: Consenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定、アプリ、Safari、機能拡張、ContextFlow：機能拡張を許可をオン、すべてのWebサイト：許可。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정, 앱, Safari, 확장 프로그램, ContextFlow: 확장 프로그램 허용 켬, 모든 웹 사이트: 허용."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes, Apps, Safari, Extensões, ContextFlow: Permitir Extensão ativado, Todos os Sites: Permitir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки, Приложения, Safari, Расширения, ContextFlow: «Разрешить расширение» включено, «Все веб-сайты»: Разрешить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметри, Програми, Safari, Розширення, ContextFlow: «Дозволити розширення» увімкнено, «Усі вебсайти»: Дозволити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt, Ứng dụng, Safari, Tiện ích mở rộng, ContextFlow: bật Cho phép tiện ích mở rộng, Tất cả trang web: Cho phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置、App、Safari、扩展、ContextFlow：打开“允许扩展”，“所有网站”：允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定、App、Safari、延伸功能、ContextFlow：已開啟「允許延伸功能」，「所有網站」設為「允許」。"
          }
        }
      }
    },
