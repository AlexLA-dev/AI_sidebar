          }
        }
      }
    },
    "Type in the search over the chat list: every chat with those words, with the place they're in. A result opens the chat right there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in die Suche über der Chatliste: alle Chats mit diesen Wörtern, samt der Stelle. Ein Treffer öffnet den Chat genau dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe en la búsqueda sobre la lista: todos los chats con esas palabras y el lugar donde están. Un resultado abre el chat justo ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez dans la recherche au-dessus de la liste : toutes les discussions avec ces mots, et l’endroit où ils figurent. Un résultat ouvre la discussion à cet endroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi nella ricerca sopra l’elenco: tutte le chat con quelle parole e il punto in cui compaiono. Un risultato apre la chat proprio lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット一覧の上の検索に入力すると、その単語を含むチャットと該当箇所が表示されます。結果をタップするとその箇所が開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 목록 위 검색에 입력하면 그 단어가 있는 채팅과 위치가 나와요. 결과를 탭하면 바로 그 부분이 열려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite na busca acima da lista: todas as conversas com essas palavras e onde elas estão. Um resultado abre a conversa ali mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите слова в поиск над списком чатов: появятся все чаты с ними и место, где они есть. Результат откроет чат прямо там."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть слова в пошук над списком чатів: з’являться всі чати з ними й місце, де вони є. Результат відкриє чат саме там."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在对话列表上方的搜索中输入：会列出包含这些词的所有对话及其位置。点按结果即可直接跳到那里。"
          }
        }
      }
    },
    "Tags and folders": {
      "localizations": {
        "de": {
          "stringUnit": {
