    "Turn on Google next to the question field to answer with Google Search: news, prices and anything recent, with sources.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte neben dem Fragefeld „Google“ ein, um mit der Google-Suche zu antworten: Nachrichten, Preise und alles Aktuelle – mit Quellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Google junto al campo de pregunta para responder con la Búsqueda de Google: noticias, precios y todo lo reciente, con fuentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Google à côté du champ de question pour répondre avec la Recherche Google : actualités, prix et tout ce qui est récent, avec les sources."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Google accanto al campo della domanda per rispondere con la Ricerca Google: notizie, prezzi e tutto ciò che è recente, con le fonti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問欄の横の「Google」をオンにすると、Google検索をもとに答えます。ニュースや価格など最新の情報を出典付きで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문 입력란 옆의 Google을 켜면 Google 검색으로 답합니다. 뉴스, 가격 등 최신 정보를 출처와 함께 알려 드려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Google ao lado do campo de pergunta para responder com a Pesquisa Google: notícias, preços e tudo o que é recente, com fontes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Google рядом с полем вопроса, чтобы ответ строился на Поиске Google: новости, цены и всё свежее — со ссылками на источники."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Google біля поля запитання, щоб відповідь спиралася на Пошук Google: новини, ціни й усе свіже — з джерелами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开提问框旁的 Google，即可借助 Google 搜索回答：新闻、价格等最新信息，并附上来源。"
          }
        }
      }
    },
    "A chat follows you": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Chat geht mit"
          }
        },
        "es": {
