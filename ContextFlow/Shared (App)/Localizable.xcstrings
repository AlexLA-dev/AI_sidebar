            "value": "チャットを検索"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 검색하기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque nas suas conversas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск по чатам"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук у чатах"
          }
        },
