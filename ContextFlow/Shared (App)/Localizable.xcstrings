    "Open it on any page": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتحه في أي صفحة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf jeder Seite öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ábrelo en cualquier página"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez-le sur n’importe quelle page"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprilo su qualsiasi pagina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのページでも開ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 페이지에서나 열기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra em qualquer página"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывается на любой странице"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкривається на будь-якій сторінці"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở trên mọi trang"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意页面打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何頁面打開"
          }
        }
      }
    },
    "Tap ✦ on the page, or open the page menu in the address bar and choose ContextFlow.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على ✦ في الصفحة، أو افتح قائمة الصفحة في شريط العناوين واختر ContextFlow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf der Seite auf ✦ – oder öffne in der Adressleiste das Seitenmenü und wähle „ContextFlow“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ✦ en la página, o abre el menú de la página en la barra de direcciones y elige ContextFlow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ✦ sur la page, ou ouvrez le menu de la page dans la barre d’adresse et choisissez ContextFlow."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ✦ sulla pagina, oppure apri il menu della pagina nella barra degli indirizzi e scegli ContextFlow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ上の✦をタップするか、アドレスバーのページメニューを開いて「ContextFlow」を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지에서 ✦를 탭하거나, 주소 막대의 페이지 메뉴를 열고 ContextFlow를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ✦ na página, ou abra o menu da página na barra de endereço e escolha ContextFlow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь ✦ на странице — или откройте меню страницы в адресной строке и выберите ContextFlow."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться ✦ на сторінці — або відкрийте меню сторінки в адресному рядку й виберіть ContextFlow."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào ✦ trên trang, hoặc mở menu trang trên thanh địa chỉ và chọn ContextFlow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点页面上的 ✦，或打开地址栏中的页面菜单并选择“ContextFlow”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下頁面上的 ✦，或打開網址列中的頁面選單並選擇「ContextFlow」。"
          }
        }
      }
    },
    "Click ✦ on the page or the ContextFlow icon in the toolbar, or press Control-Shift-E.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على ✦ في الصفحة أو على أيقونة ContextFlow في شريط الأدوات، أو اضغط Control-Shift-E."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf der Seite auf ✦ oder in der Symbolleiste auf das ContextFlow-Symbol – oder drücke Control-Shift-E."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en ✦ en la página o en el icono de ContextFlow de la barra de herramientas, o pulsa Control-Shift-E."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur ✦ dans la page ou sur l’icône ContextFlow dans la barre d’outils, ou appuyez sur Control-Shift-E."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su ✦ nella pagina o sull’icona di ContextFlow nella barra degli strumenti, oppure premi Control-Shift-E."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ上の✦かツールバーのContextFlowアイコンをクリックするか、Control-Shift-Eを押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지의 ✦나 도구 막대의 ContextFlow 아이콘을 클릭하거나 Control-Shift-E를 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em ✦ na página ou no ícone do ContextFlow na barra de ferramentas, ou pressione Control-Shift-E."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ✦ на странице или значок ContextFlow на панели инструментов — или сочетание клавиш Control-Shift-E."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть ✦ на сторінці або іконку ContextFlow на панелі інструментів — чи клавіші Control-Shift-E."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm vào ✦ trên trang hoặc biểu tượng ContextFlow trên thanh công cụ, hoặc nhấn Control-Shift-E."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按页面上的 ✦ 或工具栏中的 ContextFlow 图标，或按下 Control-Shift-E。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下頁面上的 ✦ 或工具列中的 ContextFlow 圖像，或按下 Control-Shift-E。"
          }
        }
      }
    },
    "One tap for the gist": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخلاصة بضغطة واحدة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wesentliche mit einem Tipp"
          }
        },
        "es": {
          "stringUnit": {
