            "state": "translated",
            "value": "Schnellaktionen unter der Auswahl"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acciones rápidas bajo la selección"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions rapides sous la sélection"
          }
        },
        "it": {
