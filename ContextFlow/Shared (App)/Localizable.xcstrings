    "Notifications are off for ContextFlow. Turn them on in Settings → Notifications → ContextFlow.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات متوقفة لـ ContextFlow. شغّلها من الإعدادات ← الإشعارات ← ContextFlow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen für ContextFlow sind aus. Schalte sie ein unter Einstellungen → Mitteilungen → ContextFlow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de ContextFlow están desactivadas. Actívalas en Ajustes → Notificaciones → ContextFlow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de ContextFlow sont désactivées. Activez-les dans Réglages → Notifications → ContextFlow."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche di ContextFlow sono disattivate. Attivale in Impostazioni → Notifiche → ContextFlow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlowの通知がオフになっています。設定 → 通知 → ContextFlow でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlow 알림이 꺼져 있어요. 설정 → 알림 → ContextFlow에서 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações do ContextFlow estão desativadas. Ative em Ajustes → Notificações → ContextFlow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления для ContextFlow выключены. Включите их: Настройки → Уведомления → ContextFlow."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення для ContextFlow вимкнено. Увімкніть їх: Параметри → Сповіщення → ContextFlow."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo của ContextFlow đang tắt. Hãy bật trong Cài đặt → Thông báo → ContextFlow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlow 的通知已关闭。请在这里打开：设置 → 通知 → ContextFlow。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlow 的通知已關閉。請到「設定」→「通知」→「ContextFlow」開啟。"
          }
        }
      }
    },
