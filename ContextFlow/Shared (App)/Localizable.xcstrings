    "Keeps playing with the screen locked. Controls are on the lock screen too.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر التشغيل حتى مع قفل الشاشة. وأزرار التحكم موجودة على شاشة القفل أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft bei gesperrtem Bildschirm weiter. Die Steuerung gibt es auch auf dem Sperrbildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue sonando con la pantalla bloqueada. Los controles también están en la pantalla de bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture continue écran verrouillé. Les commandes sont aussi sur l’écran verrouillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua anche a schermo bloccato. I controlli sono anche nella schermata di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面をロックしても再生が続きます。ロック画面でも操作できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 잠가도 계속 재생돼요. 잠금 화면에서도 조작할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua tocando com a tela bloqueada. Os controles também ficam na tela de bloqueio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звучит даже при заблокированном экране. Управление есть и на экране блокировки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звучить навіть із заблокованим екраном. Керування є й на екрані блокування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn phát tiếp khi khóa màn hình. Các nút điều khiển cũng có trên màn hình khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁屏后也会继续播放，在锁定屏幕上也能控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定螢幕後也會繼續播放，在鎖定畫面上也能控制。"
          }
        }
      }
    },
