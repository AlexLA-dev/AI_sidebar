    "Pick Summarize, Key takeaways, Explain or Translate, or ask your own question.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر «تلخيص» أو «أهم النقاط» أو «اشرح ببساطة» أو «ترجمة»، أو اطرح سؤالك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Zusammenfassen“, „Das Wichtigste“, „Einfach erklären“ oder „Übersetzen“ – oder stell deine eigene Frage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige “Resumir”, “Ideas clave”, “Explicar sencillo” o “Traducir”, o haz tu propia pregunta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez « Résumer », « Points clés », « En termes simples » ou « Traduire », ou posez votre propre question."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli “Riassumi”, “Punti chiave”, “In parole semplici” o “Traduci”, oppure fai una domanda tutta tua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「要約」「重要ポイント」「やさしく解説」「翻訳」から選ぶか、自由に質問します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요약, 핵심 정리, 쉽게 설명, 번역 중에서 선택하거나 직접 질문하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha “Resumir”, “Pontos-chave”, “Explicação simples” ou “Traduzir”, ou faça sua própria pergunta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Кратко», «Главное», «Объясни просто» или «Перевести» — или задайте свой вопрос."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть «Коротко», «Ключові тези», «Пояснити просто» або «Перекласти» — чи поставте власне запитання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn Tóm tắt, Ý chính, Giải thích đơn giản hoặc Dịch, hoặc tự đặt câu hỏi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“总结”“关键要点”“通俗解释”或“翻译”，或者提出你自己的问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「摘要」、「重點整理」、「簡單解釋」或「翻譯」，或是問你自己的問題。"
          }
        }
      }
    },
    "Plans couldn't be loaded. Check your connection.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل الخطط. تحقق من اتصالك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarife konnten nicht geladen werden. Prüfe deine Internetverbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cargar los planes. Comprueba tu conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les forfaits. Vérifiez votre connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare i piani. Controlla la connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランを読み込めませんでした。インターネット接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요금제를 불러올 수 없어요. 인터넷 연결을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os planos. Verifique sua conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить тарифы. Проверьте подключение к интернету."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити тарифи. Перевірте з’єднання з інтернетом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được các gói. Hãy kiểm tra kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入套餐。请检查网络连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入方案。請檢查網路連線。"
          }
        }
      }
    },
