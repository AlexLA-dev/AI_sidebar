    "Open any page and tap ✦ — or choose ContextFlow in the page menu of the address bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine beliebige Seite und tippe auf ✦ – oder wähle ContextFlow im Seitenmenü der Adressleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre cualquier página y toca ✦, o elige ContextFlow en el menú de la página en la barra de direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une page et touchez ✦, ou choisissez ContextFlow dans le menu de la page de la barre d’adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri una pagina qualsiasi e tocca ✦, oppure scegli ContextFlow nel menu della pagina nella barra degli indirizzi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意のページを開いて✦をタップするか、アドレスバーのページメニューからContextFlowを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 페이지나 열고 ✦를 탭하거나 주소 막대의 페이지 메뉴에서 ContextFlow를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra qualquer página e toque em ✦, ou escolha ContextFlow no menu da página na barra de endereço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте любую страницу и нажмите ✦ — или выберите ContextFlow в меню страницы в адресной строке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте будь-яку сторінку й торкніться ✦ — або виберіть ContextFlow у меню сторінки в адресному рядку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开任意网页并轻点 ✦，或在地址栏的网页菜单中选择 ContextFlow。"
          }
        }
      }
    },
    "Settings, Apps, Safari, Extensions, ContextFlow: Allow Extension on, All Websites: Allow.": {
      "localizations": {
        "de": {
