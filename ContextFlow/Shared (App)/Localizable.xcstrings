    "Open any page and click the ContextFlow icon in the toolbar. If Safari asks, allow it on every website.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne eine beliebige Seite und klicke in der Symbolleiste auf das ContextFlow-Symbol. Wenn Safari fragt, erlaube es auf allen Websites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre cualquier página y haz clic en el icono de ContextFlow de la barra de herramientas. Si Safari pregunta, permítelo en todos los sitios web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une page et cliquez sur l’icône ContextFlow dans la barre d’outils. Si Safari le demande, autorisez-le sur tous les sites web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri una pagina qualsiasi e fai clic sull’icona di ContextFlow nella barra degli strumenti. Se Safari lo chiede, consentilo su tutti i siti web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意のページを開き、ツールバーのContextFlowアイコンをクリックしてください。Safariに確認されたら、すべてのWebサイトで許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 페이지나 열고 도구 막대의 ContextFlow 아이콘을 클릭하세요. Safari가 물으면 모든 웹 사이트에서 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra qualquer página e clique no ícone do ContextFlow na barra de ferramentas. Se o Safari perguntar, permita em todos os sites."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте любую страницу и нажмите значок ContextFlow на панели инструментов. Если Safari спросит, разрешите его на всех веб-сайтах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте будь-яку сторінку й натисніть значок ContextFlow на панелі інструментів. Якщо Safari запитає, дозвольте його на всіх вебсайтах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开任意网页，点按工具栏中的 ContextFlow 图标。如果 Safari 询问，请允许其在所有网站上运行。"
          }
        }
      }
    },
