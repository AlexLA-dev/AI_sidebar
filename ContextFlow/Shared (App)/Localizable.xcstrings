    "Listen to answers and whole pages in a natural voice: %lld minutes a week": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستماع إلى الإجابات والصفحات كاملة بصوت طبيعي: %lld دقيقة أسبوعيًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten und ganze Seiten mit natürlicher Stimme anhören: %lld Minuten pro Woche"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha respuestas y páginas enteras con una voz natural: %lld minutos a la semana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoutez les réponses et des pages entières avec une voix naturelle : %lld minutes par semaine"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta risposte e pagine intere con una voce naturale: %lld minuti a settimana"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答やページ全体を自然な声で読み上げ：週%lld分"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변과 페이지 전체를 자연스러운 목소리로 듣기: 주당 %lld분"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouça respostas e páginas inteiras em uma voz natural: %lld minutos por semana"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы и целые страницы вслух, естественным голосом: %lld мин в неделю"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповіді й цілі сторінки вголос, природним голосом: %lld хв на тиждень"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghe câu trả lời và cả trang bằng giọng tự nhiên: %lld phút mỗi tuần"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用自然的声音朗读回答和整个页面：每周 %lld 分钟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用自然的聲音朗讀回答和整個頁面：每週 %lld 分鐘"
          }
        }
      }
    },
    "Find similar: alternatives to any page — cheaper, newer, in stock or in your language — %lld searches a week": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث عن المشابه: بدائل لأي صفحة — أرخص أو أحدث أو متوفرة أو بلغتك — %lld عملية بحث أسبوعيًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähnliches finden: Alternativen zu jeder Seite – günstiger, neuer, verfügbar oder in deiner Sprache – %lld Suchen pro Woche"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar similares: alternativas a cualquier página (más baratas, más nuevas, disponibles o en tu idioma), %lld búsquedas a la semana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouver similaire : des alternatives à n'importe quelle page (moins chères, plus récentes, en stock ou dans votre langue), %lld recherches par semaine"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova simili: alternative a qualsiasi pagina (più economiche, più recenti, disponibili o nella tua lingua), %lld ricerche a settimana"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "似たものを探す：どのページにも代わりの候補を。より安い、より新しい、在庫あり、自分の言語で。週%lld回"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비슷한 것 찾기: 어떤 페이지든 대안을 찾아 줍니다. 더 싸거나, 더 새롭거나, 재고가 있거나, 내 언어로. 주당 %lld회"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrar parecidos: alternativas a qualquer página (mais baratas, mais novas, em estoque ou no seu idioma), %lld buscas por semana"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найти похожее: альтернативы любой странице — дешевле, новее, в наличии или на вашем языке, %lld поисков в неделю"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайти схоже: альтернативи будь-якій сторінці — дешевше, новіше, в наявності або вашою мовою, %lld пошуків на тиждень"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm tương tự: lựa chọn thay thế cho mọi trang — rẻ hơn, mới hơn, còn hàng hoặc bằng ngôn ngữ của bạn — %lld lượt tìm mỗi tuần"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找相似：为任何页面找替代选择——更便宜、更新、有货或用你的语言，每周 %lld 次搜索"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找相似：為任何頁面找替代選擇——更便宜、更新、有貨或用你的語言，每週 %lld 次搜尋"
          }
        }
      }
    },
