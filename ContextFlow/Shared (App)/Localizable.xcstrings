    "Keep listening when you leave Safari or lock the screen: a notification carries it on in the app, from the same second.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابِع الاستماع عند مغادرة Safari أو قفل الشاشة: إشعار يكمله في التطبيق من الثانية نفسها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör weiter, wenn du Safari verlässt oder den Bildschirm sperrst: Eine Mitteilung setzt es in der App fort, ab derselben Sekunde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue escuchando al salir de Safari o bloquear la pantalla: una notificación lo continúa en la app, desde el mismo segundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez l’écoute quand vous quittez Safari ou verrouillez l’écran : une notification la reprend dans l’app, à la même seconde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua ad ascoltare quando esci da Safari o blocchi lo schermo: una notifica lo riprende nell’app, dallo stesso secondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariを離れたり画面をロックしたりしても聴き続けられます。通知から、同じ秒からアプリで続きを再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari를 떠나거나 화면을 잠가도 계속 들을 수 있습니다. 알림을 누르면 앱에서 같은 초부터 이어서 재생합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue ouvindo ao sair do Safari ou bloquear a tela: uma notificação continua no app, a partir do mesmo segundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушайте дальше, когда уходите из Safari или блокируете экран: уведомление продолжит чтение в приложении с той же секунды."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слухайте далі, коли виходите з Safari або блокуєте екран: сповіщення продовжить читання в застосунку з тієї ж секунди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghe tiếp khi bạn rời Safari hoặc khóa màn hình: một thông báo sẽ phát tiếp trong ứng dụng, từ đúng giây đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开 Safari 或锁定屏幕时也能继续收听：点通知即可在 App 中从同一秒继续播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離開 Safari 或鎖定螢幕時也能繼續收聽：點通知即可在 App 中從同一秒繼續播放。"
          }
        }
      }
    },
    "Reminders you set on answers and notes.": {
