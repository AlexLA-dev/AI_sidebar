    "AI for every page in Safari": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI für jede Seite in Safari"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IA para cualquier página en Safari"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA pour chaque page dans Safari"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA per ogni pagina in Safari"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SafariのどのページにもAIを"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari의 모든 페이지에 AI를"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "IA para qualquer página no Safari"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ для любой страницы в Safari"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ШІ для будь-якої сторінки в Safari"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Safari 中的每个网页都有 AI 相助"
          }
        }
      }
    },
    "Ask about selected text, rewrite it or draft a reply": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen zu markiertem Text, Umformulieren und Antwortentwürfe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntas sobre el texto seleccionado, reescritura y borradores de respuesta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions sur le texte sélectionné, reformulation et brouillons de réponse"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Domande sul testo selezionato, riscrittura e bozze di risposta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストへの質問、書き直し、返信の下書き"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 텍스트에 대한 질문, 다시 쓰기, 답장 초안 작성"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntas sobre o texto selecionado, reescrita e rascunhos de resposta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопросы по выделенному тексту, его переписывание и черновики ответов"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитання про виділений текст, його переписування й чернетки відповідей"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就选中文本提问、改写或起草回复"
          }
        }
      }
    },
    "Click the ContextFlow icon in the toolbar or press Control-Shift-E.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in der Symbolleiste auf das ContextFlow-Symbol oder drücke Control-Shift-E."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el icono de ContextFlow en la barra de herramientas o pulsa Control-Shift-E."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l’icône ContextFlow dans la barre d’outils ou appuyez sur Control-Shift-E."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sull’icona di ContextFlow nella barra degli strumenti o premi Control-Shift-E."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーのContextFlowアイコンをクリックするか、Control-Shift-Eを押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 막대에서 ContextFlow 아이콘을 클릭하거나 Control-Shift-E를 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no ícone do ContextFlow na barra de ferramentas ou pressione Control-Shift-E."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите значок ContextFlow на панели инструментов или сочетание клавиш Control-Shift-E."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть іконку ContextFlow на панелі інструментів або клавіші Control-Shift-E."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按工具栏中的 ContextFlow 图标，或按下 Control-Shift-E。"
          }
        }
      }
    },
