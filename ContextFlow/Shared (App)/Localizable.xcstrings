    "Set one on an answer or a note, with the bell by selected text in Safari, or on a page: … → Remind me about this page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف تذكيرًا على إجابة أو ملاحظة، أو بالجرس بجانب النص المحدد في Safari، أو على صفحة: … ← ذكّرني بهذه الصفحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze eine an einer Antwort oder Notiz, in Safari mit der Glocke an markiertem Text oder auf einer Seite: … → An diese Seite erinnern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon uno en una respuesta o una nota, en Safari con la campana junto al texto seleccionado, o en una página: … → Recordarme esta página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez-en un sur une réponse ou une note, dans Safari avec la cloche près d’un texte sélectionné, ou sur une page : … → Me rappeler cette page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostane uno su una risposta o una nota, in Safari con la campanella sul testo selezionato, o su una pagina: … → Ricordami questa pagina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答やメモで、Safari で選択したテキストのベルで、またはページで設定できます：… → このページをリマインド。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변이나 메모에서, Safari에서 선택한 텍스트의 종으로, 또는 페이지에서 설정하세요: … → 이 페이지 리마인더 설정."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um em uma resposta ou nota, no Safari com o sino no texto selecionado, ou em uma página: … → Me lembrar desta página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставьте его у ответа или заметки, в Safari колокольчиком у выделенного текста или на странице: … → Напомнить об этой странице."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставте його біля відповіді чи нотатки, у Safari дзвіночком біля виділеного тексту або на сторінці: … → Нагадати про цю сторінку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt lời nhắc trên câu trả lời hoặc ghi chú, bằng hình chuông cạnh văn bản đã chọn trong Safari, hoặc trên trang: … → Nhắc tôi về trang này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在回答或笔记上设置，在 Safari 中用选中文字旁的铃铛，或在网页上：… → 提醒我看这个页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在回答或筆記上設定，在 Safari 中用選取文字旁的鈴鐺設定，或在頁面上：「…」→「提醒我看這個頁面」。"
          }
        }
      }
    },
