    "Ask about selected text, rewrite it or draft a reply": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen zu markiertem Text, Umformulieren und Antwortentwürfe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntas sobre el texto seleccionado, reescritura y borradores de respuesta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions sur le texte sélectionné, reformulation et brouillons de réponse"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Domande sul testo selezionato, riscrittura e bozze di risposta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したテキストへの質問、書き直し、返信の下書き"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 텍스트에 대한 질문, 다시 쓰기, 답장 초안 작성"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntas sobre o texto selecionado, reescrita e rascunhos de resposta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопросы по выделенному тексту, его переписывание и черновики ответов"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитання про виділений текст, його переписування й чернетки відповідей"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就选中文本提问、改写或起草回复"
          }
        }
      }
    },
