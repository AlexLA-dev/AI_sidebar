            "value": "✦ボタンをすべてのサイトで再表示（%lld件非表示）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사이트에서 ✦ 버튼 다시 표시(%lld개 숨김)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar o botão ✦ em todos os sites de novo (%lld ocultos)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова показывать кнопку ✦ на всех сайтах (скрыта на %lld)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знову показувати кнопку ✦ на всіх сайтах (приховано на %lld)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有网站重新显示 ✦ 按钮（已隐藏 %lld 个）"
          }
        }
      }
    },
