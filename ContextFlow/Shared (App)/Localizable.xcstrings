            "value": "خدمة AI مشغولة. يُرجى المحاولة بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der KI-Dienst ist ausgelastet. Versuch es gleich noch einmal."
          }
        },
