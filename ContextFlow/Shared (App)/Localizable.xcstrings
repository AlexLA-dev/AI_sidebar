    "%@ is active. Open Safari and tap ✦ on any page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ مفعّل. افتح Safari واضغط على ✦ في أي صفحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist aktiv. Öffne Safari und tippe auf einer beliebigen Seite auf ✦."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está activo. Abre Safari y toca ✦ en cualquier página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est activé. Ouvrez Safari et touchez ✦ sur n’importe quelle page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è attivo. Apri Safari e tocca ✦ su qualsiasi pagina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が有効になりました。Safariを開いて、好きなページで✦をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@가 활성화되었어요. Safari를 열고 아무 페이지에서나 ✦를 탭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está ativo. Abra o Safari e toque em ✦ em qualquer página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ активен. Откройте Safari и коснитесь ✦ на любой странице."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
