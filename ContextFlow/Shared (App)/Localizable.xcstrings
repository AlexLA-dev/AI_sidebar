    "Settings opens on ContextFlow's page: tap “Apps” at the top left, then follow the steps above.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح الإعدادات على صفحة ContextFlow: اضغط على «التطبيقات» في أعلى اليمين، ثم اتبع الخطوات أعلاه."
          }
        },
        "de": {
          "stringUnit": {
