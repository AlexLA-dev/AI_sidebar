    "%@ starts now. Apple refunds the unused part of %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ %@ الآن. تعيد لك Apple قيمة الجزء غير المستخدم من %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ startet sofort. Apple erstattet den ungenutzten Teil des Tarifs %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ empieza ya. Apple reembolsa la parte no usada del plan %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ démarre tout de suite. Apple rembourse la partie non utilisée du forfait %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ inizia subito. Apple rimborsa la parte non usata del piano %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすぐに始まります。%@ の未使用分は Apple が返金します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 바로 시작돼요. %@의 남은 기간은 Apple이 환불해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ começa agora. A Apple reembolsa a parte não usada do plano %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ начнётся сразу. Неиспользованную часть тарифа %@ Apple вернёт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ почнеться одразу. Невикористану частину тарифу %@ Apple поверне."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bắt đầu ngay. Apple hoàn tiền phần chưa dùng của gói %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 立即生效。Apple 会退还 %@ 套餐未使用的部分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 立即生效。Apple 會退還 %@ 方案未使用的部分。"
          }
        }
      }
    },
