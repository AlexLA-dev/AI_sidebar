          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternativas a cualquier página: más baratas, más nuevas, disponibles o en tu idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des alternatives à n’importe quelle page : moins chères, plus récentes, en stock ou dans votre langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative a qualsiasi pagina: più economiche, più recenti, disponibili o nella tua lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのページにも代わりの候補を。より安い、より新しい、在庫あり、自分の言語で。"
