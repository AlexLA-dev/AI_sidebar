    "Notifications are off for ContextFlow. Turn them on in Settings, then come back to Safari.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشعارات ContextFlow متوقفة. فعّلها من الإعدادات ثم عُد إلى Safari."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für ContextFlow aus. Aktiviere sie in den Einstellungen und kehre dann zu Safari zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de ContextFlow están desactivadas. Actívalas en Ajustes y vuelve a Safari."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de ContextFlow sont désactivées. Activez-les dans Réglages, puis revenez dans Safari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche di ContextFlow sono disattivate. Attivale in Impostazioni, poi torna su Safari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlowの通知はオフになっています。設定でオンにしてから、Safariに戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlow 알림이 꺼져 있습니다. 설정에서 켠 다음 Safari로 돌아가세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações do ContextFlow estão desativadas. Ative-as em Ajustes e volte ao Safari."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления для ContextFlow выключены. Включите их в Настройках и вернитесь в Safari."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення для ContextFlow вимкнено. Увімкніть їх у Параметрах і поверніться в Safari."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo của ContextFlow đang tắt. Hãy bật trong Cài đặt rồi quay lại Safari."
