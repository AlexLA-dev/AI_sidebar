    "Click the ContextFlow icon in the toolbar or press Control-Shift-E.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in der Symbolleiste auf das ContextFlow-Symbol oder drücke Control-Shift-E."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el icono de ContextFlow en la barra de herramientas o pulsa Control-Shift-E."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l’icône ContextFlow dans la barre d’outils ou appuyez sur Control-Shift-E."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sull’icona di ContextFlow nella barra degli strumenti o premi Control-Shift-E."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーのContextFlowアイコンをクリックするか、Control-Shift-Eを押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 막대에서 ContextFlow 아이콘을 클릭하거나 Control-Shift-E를 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no ícone do ContextFlow na barra de ferramentas ou pressione Control-Shift-E."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите значок ContextFlow на панели инструментов или сочетание клавиш Control-Shift-E."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть іконку ContextFlow на панелі інструментів або клавіші Control-Shift-E."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按工具栏中的 ContextFlow 图标，或按下 Control-Shift-E。"
          }
        }
      }
    },
