    "Listen": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استماع"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhören"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écouter"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듣기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушать"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слухати"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghe"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朗读"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "朗讀"
          }
        }
      }
    },
    "Tap Listen under an answer, or choose Listen to this page in the … menu at the top of the panel. A natural voice reads it aloud.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «استماع» تحت الإجابة، أو اختر «الاستماع إلى هذه الصفحة» من قائمة … أعلى اللوحة. يقرأ صوت طبيعي النص بصوت عالٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe unter einer Antwort auf „Anhören“ oder wähle „Diese Seite anhören“ im Menü „…“ oben im Panel. Eine natürliche Stimme liest den Text vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Escuchar» bajo una respuesta, o elige «Escuchar esta página» en el menú «…» arriba del panel. Una voz natural lee el texto en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez « Écouter » sous une réponse, ou choisissez « Écouter cette page » dans le menu « … » en haut du panneau. Une voix naturelle lit le texte à voix haute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca «Ascolta» sotto una risposta, oppure scegli «Ascolta questa pagina» nel menu «…» in alto nel pannello. Una voce naturale legge il testo ad alta voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答の下の「読み上げ」をタップするか、パネル上部の「…」メニューから「このページを読み上げ」を選びます。自然な声で読み上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변 아래 ‘듣기’를 탭하거나, 패널 위쪽 ‘…’ 메뉴에서 ‘이 페이지 듣기’를 고르세요. 자연스러운 목소리로 읽어 줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em “Ouvir” abaixo de uma resposta, ou escolha “Ouvir esta página” no menu “…” no topo do painel. Uma voz natural lê o texto em voz alta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Слушать» под ответом или выберите «Слушать эту страницу» в меню «…» вверху панели. Текст прочитает естественный голос."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть «Слухати» під відповіддю або виберіть «Слухати цю сторінку» в меню «…» угорі панелі. Текст прочитає природний голос."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào Nghe dưới câu trả lời, hoặc chọn Nghe trang này trong menu … ở đầu bảng. Một giọng đọc tự nhiên sẽ đọc to văn bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点回答下方的“朗读”，或在面板顶部的“…”菜单中选择“朗读此页面”。自然的声音会把内容读出来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下回答下方的「朗讀」，或在面板頂部的「…」選單中選擇「朗讀這個頁面」。自然的聲音會把內容讀出來。"
          }
        }
      }
    },
    "Find similar": {
      "localizations": {
        "ar": {
          "stringUnit": {
