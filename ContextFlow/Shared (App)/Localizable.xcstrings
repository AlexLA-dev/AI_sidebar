    "Save the replies you write again and again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere Antworten, die du immer wieder schreibst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las respuestas que escribes una y otra vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez les réponses que vous écrivez encore et encore"
          }
        },
        "it": {
