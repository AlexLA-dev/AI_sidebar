    "AI for every page in Safari": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "AI لكل صفحة في Safari"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI für jede Seite in Safari"
          }
        },
        "es": {
