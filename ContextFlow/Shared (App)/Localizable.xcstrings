    "Turn it on to ask about pages and add to your chats.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّله لتسأل عن الصفحات وتضيف إلى محادثاتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte es ein, um Fragen zu Seiten zu stellen und deine Chats fortzusetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo para preguntar sobre páginas y seguir tus chats."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le pour poser des questions sur les pages et poursuivre vos discussions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo per fare domande sulle pagine e continuare le tue chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、ページについて質問してチャットを続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 페이지에 대해 묻고 채팅을 이어갈 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative-o para perguntar sobre páginas e continuar suas conversas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите его, чтобы спрашивать о страницах и продолжать чаты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть його, щоб питати про сторінки й продовжувати чати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật lên để hỏi về các trang và tiếp tục các cuộc trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后即可询问页面内容并继续对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，就能詢問頁面內容並接續你的對話。"
          }
        }
      }
    },
