    "Turn on ContextFlow to summarize any page in one tap. 5 free answers every day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte ContextFlow ein und fasse jede Seite mit einem Tippen zusammen. 5 Gratis-Antworten jeden Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa ContextFlow para resumir cualquier página con un toque. 5 respuestas gratis cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez ContextFlow pour résumer n’importe quelle page d’un toucher. 5 réponses gratuites chaque jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva ContextFlow per riassumere qualsiasi pagina con un tocco. 5 risposte gratuite ogni giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlowをオンにすると、どんなページもワンタップで要約できます。毎日5回まで無料。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlow를 켜면 어떤 페이지든 한 번의 탭으로 요약할 수 있어요. 매일 무료 답변 5개."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o ContextFlow para resumir qualquer página com um toque. 5 respostas grátis todo dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите ContextFlow, чтобы пересказывать любую страницу одним нажатием. 5 бесплатных ответов каждый день."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть ContextFlow, щоб переказувати будь-яку сторінку одним дотиком. 5 безкоштовних відповідей щодня."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 ContextFlow，轻点一下即可总结任何网页。每天 5 次免费回答。"
          }
        }
      }
    },
