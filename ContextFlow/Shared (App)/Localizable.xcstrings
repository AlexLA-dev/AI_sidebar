            "value": "Суть одним дотиком"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nắm ý chính chỉ với một chạm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键抓住要点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下抓重點"
          }
        }
      }
    },
    "Summarize, Key takeaways, Explain simply and Translate work on the whole page — no need to write a prompt.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«تلخيص» و«أهم النقاط» و«اشرح ببساطة» و«ترجمة» تعمل على الصفحة كلها، دون حاجة إلى كتابة طلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zusammenfassen“, „Das Wichtigste“, „Einfach erklären“ und „Übersetzen“ arbeiten mit der ganzen Seite – ganz ohne Prompt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Resumir”, “Ideas clave”, “Explicar sencillo” y “Traducir” trabajan con toda la página: no hace falta escribir nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Résumer », « Points clés », « En termes simples » et « Traduire » portent sur toute la page — inutile d’écrire une consigne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Riassumi”, “Punti chiave”, “In parole semplici” e “Traduci” lavorano su tutta la pagina: non serve scrivere un prompt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「要約」「重要ポイント」「やさしく解説」「翻訳」はページ全体が対象。プロンプトを書く必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요약, 핵심 정리, 쉽게 설명, 번역은 페이지 전체를 대상으로 합니다. 프롬프트를 쓸 필요가 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Resumir”, “Pontos-chave”, “Explicação simples” e “Traduzir” funcionam na página inteira — sem precisar escrever um prompt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Кратко», «Главное», «Объясни просто» и «Перевести» работают со всей страницей — писать запрос не нужно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Коротко», «Ключові тези», «Пояснити просто» і «Перекласти» працюють з усією сторінкою — писати запит не потрібно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tóm tắt, Ý chính, Giải thích đơn giản và Dịch dùng cho cả trang, không cần viết câu lệnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“总结”“关键要点”“通俗解释”和“翻译”针对整个页面，无需自己写提示词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「摘要」、「重點整理」、「簡單解釋」和「翻譯」會處理整個頁面，不用自己寫提示詞。"
          }
        }
      }
    },
    "Ask about a part": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل عن جزء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem Teil fragen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta por una parte"
          }
        },
        "fr": {
          "stringUnit": {
