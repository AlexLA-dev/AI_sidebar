    "Chats are available here for 30 days. After that time, they will be permanently deleted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى المحادثات متاحة هنا لمدة 30 يومًا. بعد ذلك، ستُحذف نهائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats sind hier 30 Tage lang verfügbar. Danach werden sie endgültig gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los chats están disponibles aquí durante 30 días. Después, se eliminarán definitivamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les discussions restent disponibles ici pendant 30 jours. Elles seront ensuite supprimées définitivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat restano disponibili qui per 30 giorni. Trascorso questo periodo, verranno eliminate definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットはここに30日間保存されます。その後、完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅은 여기에 30일 동안 보관돼요. 그 후에는 영구적으로 삭제돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As conversas ficam disponíveis aqui por 30 dias. Depois disso, serão apagadas permanentemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаты хранятся здесь 30 дней. После этого они будут удалены навсегда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чати зберігаються тут 30 днів. Після цього їх буде видалено назавжди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cuộc trò chuyện có ở đây trong 30 ngày. Sau thời gian đó, chúng sẽ bị xóa vĩnh viễn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话会在这里保留 30 天，之后将被永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話會在這裡保留 30 天，之後將永久刪除。"
          }
        }
      }
    },
