    "Hi %@, thanks for the call on %@. As promised, here are the next steps.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا %1$@، شكرًا على مكالمة يوم %2$@. كما وعدتُ، إليك الخطوات التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo %1$@, danke für das Telefonat am %2$@. Wie versprochen hier die nächsten Schritte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola, %1$@. Gracias por la llamada del %2$@. Como te prometí, aquí tienes los próximos pasos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour %1$@, merci pour notre appel de %2$@. Comme promis, voici les prochaines étapes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao %1$@, grazie per la chiamata di %2$@. Come promesso, ecco i prossimi passi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@さん、%2$@はお電話ありがとうございました。お約束どおり、次のステップをお送りします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 님, 안녕하세요. %2$@ 통화 감사합니다. 말씀드린 대로 다음 단계를 보내 드려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oi, %1$@. Agradeço pela ligação de %2$@. Como combinado, seguem os próximos passos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добрый день, %1$@. Спасибо за звонок во %2$@. Как договаривались, вот следующие шаги."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Добрий день, %1$@. Дякую за дзвінок у %2$@. Як домовлялися, ось наступні кроки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào %1$@, cảm ơn bạn về cuộc gọi hôm %2$@. Như đã hứa, đây là các bước tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，你好。感谢%2$@的通话。按照约定，以下是接下来的步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，你好。謝謝%2$@的通話。如先前所說，以下是接下來的步驟。"
          }
        }
      }
    },
