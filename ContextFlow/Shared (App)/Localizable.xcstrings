    "Open it on any page": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf jeder Seite öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ábrelo en cualquier página"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez-le sur n’importe quelle page"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprilo su qualsiasi pagina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのページでも開ける"
          }
        },
        "ko": {
