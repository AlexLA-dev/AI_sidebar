            "value": "Interroger vos discussions (Pro)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi alle tue chat (Pro)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのチャットに質問（Pro）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 채팅에 묻기(Pro)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte às suas conversas (Pro)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопросы по всем чатам (Pro)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Питання про всі чати (Pro)"
          }
        },
