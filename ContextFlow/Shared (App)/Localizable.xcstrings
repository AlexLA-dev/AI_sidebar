    "Alternatives to any page: cheaper, newer, in stock or in your language.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدائل لأي صفحة: أرخص أو أحدث أو متوفرة أو بلغتك."
          }
        },
        "de": {
          "stringUnit": {
