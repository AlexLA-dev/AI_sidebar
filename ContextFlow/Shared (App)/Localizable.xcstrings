            "value": "Etiquetas y carpetas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags et dossiers"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag e cartelle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグとフォルダ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
