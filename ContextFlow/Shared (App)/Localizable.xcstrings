    "Answers and whole pages read aloud in a natural voice, at the speed you like.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقرأ لك الإجابات والصفحات كاملة بصوت طبيعي، بالسرعة التي تناسبك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten und ganze Seiten, vorgelesen mit natürlicher Stimme, in deinem Tempo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuestas y páginas enteras leídas en voz alta con una voz natural, a la velocidad que prefieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses et des pages entières lues à voix haute avec une voix naturelle, à la vitesse de votre choix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risposte e pagine intere lette ad alta voce con una voce naturale, alla velocità che preferisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答やページ全体を、自然な声で好きな速さで読み上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변과 페이지 전체를 자연스러운 목소리로, 원하는 속도로 읽어 줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respostas e páginas inteiras lidas em voz alta com uma voz natural, na velocidade que você preferir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы и целые страницы вслух, естественным голосом, в удобном темпе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповіді й цілі сторінки вголос, природним голосом, у зручному темпі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc to câu trả lời và cả trang bằng giọng tự nhiên, với tốc độ bạn thích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用自然的声音朗读回答和整个页面，语速随你调。"
