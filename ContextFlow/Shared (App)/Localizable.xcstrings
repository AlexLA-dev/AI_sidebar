    "I couldn't name this chat just now. Try again later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت تسمية المحادثة الآن. حاول مرة أخرى لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich konnte den Chat gerade nicht benennen. Versuch es später noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No he podido poner nombre al chat ahora. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n’ai pas pu nommer la discussion pour l’instant. Réessayez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono riuscito a dare un nome alla chat. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はチャットに名前を付けられませんでした。あとでもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 채팅 이름을 짓지 못했어요. 나중에 다시 해 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consegui nomear a conversa agora. Tente de novo mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не получилось назвать чат. Попробуйте позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося назвати чат. Спробуйте пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình chưa đặt được tên cho cuộc trò chuyện. Hãy thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法为对话命名，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法為對話命名，請稍後再試。"
          }
        }
      }
    },
