          "stringUnit": {
            "state": "translated",
            "value": "Video và PDF trên trang"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面上的视频和 PDF"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面上的影片和 PDF"
          }
        }
      }
    },
    "ContextFlow now reads a video's transcript and the PDFs on a page. Ask as usual: answers point to the moment, like [4:15], or to the PDF's page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ ContextFlow الآن نص الفيديو وملفات PDF في الصفحة. اسأل كالمعتاد: تشير الإجابة إلى اللحظة، مثل [4:15]، أو إلى صفحة ملف PDF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlow liest jetzt das Transkript eines Videos und die PDFs auf einer Seite. Frag wie gewohnt: Die Antwort nennt die Stelle, etwa [4:15], oder die Seite im PDF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora ContextFlow lee la transcripción de un vídeo y los PDF de una página. Pregunta como siempre: la respuesta señala el momento, como [4:15], o la página del PDF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlow lit désormais la transcription d’une vidéo et les PDF d’une page. Posez vos questions comme d’habitude : la réponse indique le moment, par exemple [4:15], ou la page du PDF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora ContextFlow legge la trascrizione di un video e i PDF di una pagina. Chiedi come sempre: la risposta indica il momento, come [4:15], o la pagina del PDF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlow がページの動画の文字起こしと PDF も読み取るようになりました。いつもどおり質問すると、[4:15] のような場面や PDF のページを示して答えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 ContextFlow가 페이지에 있는 동영상의 자막 전문과 PDF도 읽어요. 평소처럼 물어보면 [4:15]처럼 장면이나 PDF 페이지를 짚어 답해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora o ContextFlow lê a transcrição de um vídeo e os PDFs de uma página. Pergunte como sempre: a resposta aponta o momento, como [4:15], ou a página do PDF."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь ContextFlow читает транскрипт видео и PDF на странице. Спрашивайте как обычно: ответ укажет момент, например [4:15], или страницу PDF."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер ContextFlow читає транскрипт відео й PDF на сторінці. Запитуйте як завжди: відповідь вкаже момент, наприклад [4:15], або сторінку PDF."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ ContextFlow đọc cả bản chép lời của video và các tệp PDF trên trang. Cứ hỏi như bình thường: câu trả lời sẽ chỉ ra thời điểm, ví dụ [4:15], hoặc trang trong PDF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlow 现在也会读取页面上视频的字幕全文和 PDF。照常提问即可：回答会指出时间点，例如 [4:15]，或 PDF 的页码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlow 現在也會讀取頁面上影片的逐字稿和 PDF。照常提問即可：回答會指出對應的時間點，例如 [4:15]，或 PDF 的頁碼。"
          }
        }
      }
    },
    "Search and ask your chats": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث في محادثاتك واسألها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats durchsuchen und fragen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca y pregunta a tus chats"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherchez dans vos discussions et interrogez-les"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca nelle chat e chiedi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットを探す・質問する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 검색과 질문"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque e pergunte às suas conversas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск и вопросы по чатам"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук і запитання до чатів"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm và hỏi các cuộc trò chuyện"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索和询问你的对话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋並詢問你的對話"
          }
        }
      }
    },
    "In Chats, tap ✦ by the search and describe the chat you remember. Ask your chats, at the top of the list, answers from all your chats at once.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المحادثات، اضغط على ✦ بجانب البحث وصِف المحادثة التي تتذكرها. «اسأل محادثاتك» في أعلى القائمة يجيب من كل محادثاتك دفعة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in „Chats“ auf ✦ neben der Suche und beschreibe den Chat, an den du dich erinnerst. „Frag deine Chats“ ganz oben in der Liste antwortet aus allen Chats zugleich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Chats, toca ✦ junto a la búsqueda y describe el chat que recuerdas. «Pregunta a tus chats», arriba en la lista, responde a partir de todos tus chats a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Discussions, touchez ✦ à côté de la recherche et décrivez la discussion dont vous vous souvenez. « Interroger vos discussions », en haut de la liste, répond à partir de toutes vos discussions à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Chat, tocca ✦ accanto alla ricerca e descrivi la chat che ricordi. «Chiedi alle tue chat», in cima all’elenco, risponde da tutte le chat insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「チャット」で検索の横の ✦ をタップし、覚えているチャットを説明します。リストの一番上の「すべてのチャットに質問」は、すべてのチャットからまとめて答えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅에서 검색 옆 ✦를 탭하고 기억나는 채팅을 설명하세요. 목록 맨 위의 ‘모든 채팅에 묻기’는 모든 채팅을 한꺼번에 보고 답해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Conversas, toque em ✦ ao lado da busca e descreva a conversa de que se lembra. “Pergunte às suas conversas”, no topo da lista, responde com base em todas as suas conversas de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Чатах» нажмите ✦ рядом с поиском и опишите чат, который помните. «Вопросы по всем чатам» вверху списка отвечают сразу по всем чатам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У «Чатах» натисніть ✦ поруч із пошуком і опишіть чат, який пам’ятаєте. «Питання про всі чати» вгорі списку відповідають одразу з усіх чатів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Trò chuyện, chạm vào ✦ cạnh ô tìm kiếm và mô tả cuộc trò chuyện bạn nhớ. “Hỏi các cuộc trò chuyện” ở đầu danh sách trả lời dựa trên tất cả cuộc trò chuyện cùng lúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“对话”中点按搜索旁的 ✦，描述你记得的对话。列表顶部的“问问你的所有对话”会一次根据你所有的对话来回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「對話」中點一下搜尋旁的 ✦，描述你記得的對話。列表頂端的「詢問你的所有對話」會一次根據你所有的對話來回答。"
          }
        }
      }
    },
