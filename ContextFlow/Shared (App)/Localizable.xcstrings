    "Get answers about everything you read in Safari, all week long.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten zu allem, was du in Safari liest – die ganze Woche lang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén respuestas sobre todo lo que lees en Safari, toda la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez des réponses sur tout ce que vous lisez dans Safari, toute la semaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni risposte su tutto ciò che leggi in Safari, per tutta la settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariで読むあらゆる内容について、1週間いつでも質問できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari에서 읽는 모든 내용에 대해 일주일 내내 답변을 받아 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenha respostas sobre tudo o que você lê no Safari, a semana toda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте ответы обо всём, что читаете в Safari, — всю неделю."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримуйте відповіді про все, що читаєте в Safari, — увесь тиждень."
          }
        },
        "zh-Hans": {
