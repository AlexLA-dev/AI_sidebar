    },
    "Pro starts now. Apple refunds the unused part of Own key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro startet sofort. Apple erstattet den ungenutzten Teil von „Eigener Schlüssel“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro empieza ya. Apple reembolsa la parte no usada de Clave propia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro démarre tout de suite. Apple rembourse la partie non utilisée de Clé personnelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro inizia subito. Apple rimborsa la parte non usata di Chiave propria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro はすぐに始まります。「自分のキー」の未使用分は Apple が返金します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro는 바로 시작돼요. '내 키'의 남은 기간은 Apple이 환불해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pro começa agora. A Apple reembolsa a parte não usada do Chave própria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro начнётся сразу. Неиспользованную часть «Своего ключа» Apple вернёт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro почнеться одразу. Невикористану частину «Власного ключа» Apple поверне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 立即生效。Apple 会退还“自有密钥”未使用的部分。"
          }
        }
      }
    },
    "Move to Pro at %lld%% off": {
      "localizations": {
        "de": {
