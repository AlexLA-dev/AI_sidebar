    "Under Permissions, set All Websites to Allow.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضمن «الأذونات»، اضبط «كل مواقع الويب» على «سماح»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze unter „Berechtigungen“ die Option „Alle Websites“ auf „Erlauben“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Permisos, ajusta “Todos los sitios web” en “Permitir”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous Autorisations, réglez « Tous les sites web » sur « Autoriser »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Permessi, imposta “Tutti i siti web” su “Consenti”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アクセス権」で「すべてのWebサイト」を「許可」に設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한에서 '모든 웹 사이트'를 '허용'으로 설정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Permissões, ajuste “Todos os Sites” para “Permitir”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В разделе «Разрешения» для параметра «Все веб-сайты» выберите «Разрешить»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У розділі «Дозволи» для параметра «Усі вебсайти» виберіть «Дозволити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Quyền, đặt Tất cả trang web thành Cho phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“权限”下，将“所有网站”设为“允许”。"
