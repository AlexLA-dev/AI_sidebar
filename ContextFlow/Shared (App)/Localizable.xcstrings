    "This week's listening minutes are used up, so the rest can't be read in this voice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت دقائق الاستماع لهذا الأسبوع، لذا لا يمكن قراءة الباقي بهذا الصوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Minuten Anhören für diese Woche sind aufgebraucht, deshalb kann diese Stimme den Rest nicht vorlesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se acabaron los minutos de escucha de esta semana, así que el resto no se puede leer con esta voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les minutes d’écoute de la semaine sont épuisées : la suite ne peut pas être lue avec cette voix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I minuti di ascolto di questa settimana sono finiti, quindi il resto non si può leggere con questa voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週の読み上げ時間を使い切ったため、残りはこの声では読み上げられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 듣기 시간을 모두 사용해서 나머지는 이 목소리로 읽을 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os minutos para ouvir desta semana acabaram, então o resto não pode ser lido com esta voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минуты прослушивания на эту неделю закончились, поэтому остальное этим голосом прочитать не получится."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хвилини прослуховування на цей тиждень закінчилися, тож решту цим голосом прочитати не вийде."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã dùng hết số phút nghe của tuần này, nên phần còn lại không thể đọc bằng giọng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周的朗读时长已用完，其余部分无法用这个声音朗读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這週的朗讀時間已用完，其餘部分無法用這個聲音朗讀。"
          }
        }
      }
    },
