    "Pro gives you up to 375 answers a week on iPhone, iPad and Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Pro bekommst du bis zu 375 Antworten pro Woche auf iPhone, iPad und Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Pro obtienes hasta 375 respuestas por semana en iPhone, iPad y Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Pro, obtenez jusqu’à 375 réponses par semaine sur iPhone, iPad et Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Pro hai fino a 375 risposte a settimana su iPhone, iPad e Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proなら、iPhone、iPad、Macで週に最大375回まで回答を受け取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro를 이용하면 iPhone, iPad, Mac에서 매주 최대 375개의 답변을 받을 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o Pro, você tem até 375 respostas por semana no iPhone, iPad e Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С Pro — до 375 ответов в неделю на iPhone, iPad и Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З Pro — до 375 відповідей на тиждень на iPhone, iPad і Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级 Pro，在 iPhone、iPad 和 Mac 上每周最多可获得 375 次回答。"
          }
        }
      }
    },
    "Pro is active. Open Safari and tap ✦ on any page.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro ist aktiv. Öffne Safari und tippe auf einer beliebigen Seite auf ✦."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro está activo. Abre Safari y toca ✦ en cualquier página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro est activé. Ouvrez Safari et touchez ✦ sur n’importe quelle page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro è attivo. Apri Safari e tocca ✦ su qualsiasi pagina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proが有効になりました。Safariを開いて、好きなページで✦をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro가 활성화되었어요. Safari를 열고 아무 페이지에서나 ✦를 탭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pro está ativo. Abra o Safari e toque em ✦ em qualquer página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro активен. Откройте Safari и коснитесь ✦ на любой странице."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro активовано. Відкрийте Safari й торкніться ✦ на будь-якій сторінці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 已激活。打开 Safari，在任意页面上轻点 ✦。"
          }
        }
      }
    },
