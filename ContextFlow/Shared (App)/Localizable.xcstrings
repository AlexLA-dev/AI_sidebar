    "Settings opens on ContextFlow's page: tap “Apps” at the top left, then follow the steps above.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Einstellungen“ öffnet die Seite von ContextFlow: Tippe oben links auf „Apps“ und folge dann den Schritten oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes se abre en la página de ContextFlow: toca “Apps” arriba a la izquierda y sigue los pasos de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages s’ouvre sur la page de ContextFlow : touchez « Apps » en haut à gauche, puis suivez les étapes ci-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni si apre sulla pagina di ContextFlow: tocca “App” in alto a sinistra, poi segui i passaggi qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定はContextFlowのページで開きます。左上の「アプリ」をタップして、上の手順に進んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정이 ContextFlow 페이지로 열려요. 왼쪽 위의 ‘앱’을 탭한 다음 위의 단계를 따라 하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Ajustes abrem na página do ContextFlow: toque em “Apps” no canto superior esquerdo e siga os passos acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Настройки» откроются на странице ContextFlow: нажмите «Приложения» слева вверху и следуйте шагам выше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Параметри» відкриються на сторінці ContextFlow: торкніться «Програми» ліворуч угорі й виконайте кроки вище."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“设置”会打开 ContextFlow 的页面：轻点左上角的“App”，然后按照上面的步骤操作。"
          }
        }
      }
    },
