    "Open it on any page": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf jeder Seite öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ábrelo en cualquier página"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez-le sur n’importe quelle page"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprilo su qualsiasi pagina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのページでも開ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 페이지에서나 열기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra em qualquer página"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывается на любой странице"
          }
        },
        "uk": {
          "stringUnit": {
