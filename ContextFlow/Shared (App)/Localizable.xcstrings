    "Ask ContextFlow about a page in Safari: your chats show up here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag ContextFlow in Safari zu einer Seite – deine Chats erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a ContextFlow sobre una página en Safari: tus chats aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question à ContextFlow sur une page dans Safari : vos discussions apparaîtront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi a ContextFlow di una pagina in Safari: le tue chat compariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari でページについて ContextFlow に質問すると、チャットがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari에서 페이지에 대해 ContextFlow에 물어보면 채팅이 여기에 표시돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte ao ContextFlow sobre uma página no Safari: suas conversas aparecem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите ContextFlow о странице в Safari — ваши чаты появятся здесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитайте ContextFlow про сторінку в Safari — ваші чати з’являться тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Safari 中向 ContextFlow 询问页面内容，你的对话会显示在这里。"
          }
        }
      }
    },
