            "value": "Des infos à jour avec Google"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizie fresche da Google"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleで最新情報"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google의 최신 정보"
          }
        },
        "pt-BR": {
