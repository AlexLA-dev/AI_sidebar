    "Put blanks in braces, like {Name}. They're filled in when the template is inserted, by hand, from Copied, or from the page.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lücken in geschweifte Klammern setzen, etwa {Name}. Sie werden beim Einfügen ausgefüllt: von Hand, aus „Kopiert“ oder von der Seite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon los huecos entre llaves, como {Nombre}. Se rellenan al insertar la plantilla: a mano, desde «Copiado» o con la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez les champs à remplir entre accolades, comme {Nom}. Ils sont remplis à l’insertion : à la main, depuis « Copié » ou depuis la page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti gli spazi tra graffe, come {Nome}. Si riempiono quando inserisci il modello: a mano, da «Copiati» o dalla pagina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄は{名前}のように波かっこで囲みます。テンプレートを挿入するときに、手で、コピー履歴から、またはページから入力されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈칸은 {이름}처럼 중괄호로 감쌉니다. 템플릿을 넣을 때 직접, ‘복사한 항목’에서, 또는 페이지에서 채웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque as lacunas entre chaves, como {Nome}. Elas são preenchidas ao inserir o modelo: à mão, de “Copiados” ou pela página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропуски — в фигурных скобках, например {Имя}. Они заполняются при вставке: вручную, из «Скопированного» или со страницы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропуски — у фігурних дужках, наприклад {Ім’я}. Вони заповнюються під час вставлення: вручну, зі «Скопійованого» або зі сторінки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空格用花括号表示，例如 {姓名}。插入模板时填写：手动填写、从“已复制”中选择，或从网页填写。"
          }
        }
      }
    },
