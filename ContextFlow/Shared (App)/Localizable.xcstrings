            "value": "Öffnet den Player"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el reproductor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le lecteur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il lettore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレーヤーを開きます"
          }
        },
        "ko": {
