    "Tap ✦ next to the search and describe the chat you remember — “that article about sleep and coffee” — even without the exact words.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ✦ neben der Suche und beschreibe den Chat, an den du dich erinnerst – „der Artikel über Schlaf und Kaffee“ – auch ohne die genauen Wörter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ✦ junto a la búsqueda y describe el chat que recuerdas —«ese artículo sobre el sueño y el café»—, aunque no uses las palabras exactas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ✦ à côté de la recherche et décrivez la discussion dont vous vous souvenez — « l’article sur le sommeil et le café » — même sans les mots exacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ✦ accanto alla ricerca e descrivi la chat che ricordi — «quell’articolo su sonno e caffè» — anche senza le parole esatte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索の横の ✦ をタップし、覚えているチャットを説明します（「睡眠とコーヒーの記事」など）。正確な言葉でなくても大丈夫です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 옆 ✦를 탭하고 기억나는 채팅을 설명하세요. ‘수면과 커피에 관한 그 기사’처럼 정확한 단어가 아니어도 돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ✦ ao lado da busca e descreva a conversa de que se lembra — “aquele artigo sobre sono e café” — mesmo sem as palavras exatas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите ✦ рядом с поиском и опишите чат, который помните, — «та статья про сон и кофе», — даже без точных слов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть ✦ поруч із пошуком і опишіть чат, який пам’ятаєте, — «та стаття про сон і каву», — навіть без точних слів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按搜索旁的 ✦，描述你记得的对话（“那篇关于睡眠和咖啡的文章”），即使没有确切字词也行。"
          }
        }
      }
    },
    "Ask your chats (Pro)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag deine Chats (Pro)"
          }
        },
        "es": {
