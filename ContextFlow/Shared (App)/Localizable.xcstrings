    "Switched it on? Open Safari": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّلته؟ افتح Safari"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert? Safari öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya lo activaste? Abrir Safari"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé ? Ouvrir Safari"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivato? Apri Safari"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにしましたか？Safariを開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켰나요? Safari 열기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já ativou? Abrir Safari"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включили? Открыть Safari"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнули? Відкрити Safari"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã bật chưa? Mở Safari"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经打开了？打开 Safari"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開了嗎？開啟 Safari"
          }
        }
      }
    },
    "Tap ContextFlow and switch it on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على ContextFlow وفعّله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „ContextFlow“ und aktiviere es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ContextFlow y actívalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez ContextFlow et activez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ContextFlow e attivalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ContextFlow」をタップしてオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ContextFlow를 탭하고 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em ContextFlow e ative-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь ContextFlow и включите расширение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться ContextFlow і ввімкніть розширення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào ContextFlow và bật lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“ContextFlow”并将其打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「ContextFlow」並將其開啟。"
          }
        }
      }
    },
    "Tap the ✦ button on the page — or tap the page menu in the address bar and choose ContextFlow.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الزر ✦ في الصفحة، أو اضغط على قائمة الصفحة في شريط العناوين واختر ContextFlow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf der Seite auf die Taste ✦ – oder tippe in der Adressleiste auf das Seitenmenü und wähle „ContextFlow“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón ✦ en la página, o toca el menú de la página en la barra de direcciones y elige ContextFlow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton ✦ sur la page, ou touchez le menu de la page dans la barre d’adresse et choisissez ContextFlow."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante ✦ sulla pagina, oppure tocca il menu della pagina nella barra degli indirizzi e scegli ContextFlow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ上の✦ボタンをタップするか、アドレスバーのページメニューをタップして「ContextFlow」を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지에서 ✦ 버튼을 탭하거나, 주소 막대에서 페이지 메뉴를 탭한 다음 ContextFlow를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão ✦ na página, ou toque no menu da página na barra de endereço e escolha ContextFlow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь кнопки ✦ на странице — или откройте меню страницы в адресной строке и выберите ContextFlow."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться кнопки ✦ на сторінці — або відкрийте меню сторінки в адресному рядку й виберіть ContextFlow."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào nút ✦ trên trang, hoặc chạm vào menu trang trên thanh địa chỉ và chọn ContextFlow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点页面上的 ✦ 按钮，或者轻点地址栏中的页面菜单并选择“ContextFlow”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下頁面上的 ✦ 按鈕，或點一下網址列中的頁面選單，然後選擇「ContextFlow」。"
          }
        }
      }
    },
