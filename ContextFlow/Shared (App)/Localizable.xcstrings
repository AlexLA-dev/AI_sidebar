    "You can restore it from Recently Deleted for 30 days.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك استعادتها من «المحذوفة مؤخرًا» خلال 30 يومًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst ihn 30 Tage lang unter „Zuletzt gelöscht“ wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás restaurarlo desde Eliminados recientemente durante 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez la restaurer depuis Suppressions récentes pendant 30 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrai ripristinarla da Eliminati di recente per 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日間は「最近削除した項目」から復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일 동안 최근 삭제된 항목에서 복원할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode restaurá-la em Apagados Recentemente por 30 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его можно восстановить из «Недавно удалённых» в течение 30 дней."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його можна відновити з «Нещодавно видалених» протягом 30 днів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể khôi phục từ Đã xóa gần đây trong 30 ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天内可以从“最近删除”中恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
