# ContextFlow Environment Variables
# Copy this file to .env.local and fill in your values
# Plasmo reads .env.local automatically at build time

# ===================
# Supabase Configuration
# ===================
# Get these from your Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For client-side (browser extension) — PLASMO_PUBLIC_ prefix is required
PLASMO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PLASMO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===================
# OpenAI Configuration
# ===================
# Your OpenAI API key (used by backend proxy for free/pro users)
OPENAI_API_KEY=sk-your-openai-api-key

# ===================
# Stripe Configuration
# ===================
# Server-side (Netlify Functions) — set these in Netlify Dashboard
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Client-side Stripe Payment Links (PLASMO_PUBLIC_ prefix required)
# Create these in Stripe Dashboard > Payment Links
PLASMO_PUBLIC_STRIPE_LINK_BASIC=https://buy.stripe.com/your-basic-link
PLASMO_PUBLIC_STRIPE_LINK_PRO=https://buy.stripe.com/your-pro-link

# ===================
# API Configuration
# ===================
# For local development
PLASMO_PUBLIC_API_URL=http://localhost:8888/.netlify/functions

# For production (set this in Netlify dashboard)
# PLASMO_PUBLIC_API_URL=https://your-site.netlify.app/.netlify/functions

# ===================
# App Store (StoreKit 2) Configuration
# ===================
# Required for Safari App Store distribution
# Set these in Netlify Dashboard for the appstore-verify function

# Your app's bundle ID as registered in App Store Connect
APPSTORE_BUNDLE_ID=com.contextflow.app

# App Store Server API credentials (App Store Connect > Users & Access > Keys)
APPSTORE_KEY_ID=your-key-id
APPSTORE_ISSUER_ID=your-issuer-id

# "sandbox" for development/TestFlight, "production" for live App Store
APPSTORE_ENVIRONMENT=sandbox

# ===================
# Resend (Admin Alerts)
# ===================
# Get your API key at https://resend.com
RESEND_API_KEY=re_your-resend-api-key
ADMIN_EMAIL=your-email@example.com
