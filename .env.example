# ---------------------------------------------------------------------------
# Backend (Netlify → Project configuration → Environment variables)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # mark as "secret" in Netlify

# Optional tuning (defaults shown)
OPENAI_MODEL=gpt-4.1-mini,gpt-4o-mini     # tried in order; next one if a model is unavailable
OPENAI_MAX_TOKENS=1500
FREE_DAILY_LIMIT=5
FREE_IP_DAILY_LIMIT=40
FREE_GLOBAL_DAILY_LIMIT=3000              # daily budget guard for all free users together
PRO_WEEKLY_LIMIT=375
APPSTORE_BUNDLE_ID=com.contextflow.app
APPSTORE_ACCEPT_SANDBOX=true              # App Review and TestFlight use sandbox purchases
ENTITLEMENT_LEEWAY_HOURS=48
STRIPE_WEBHOOK_SECRET=whsec_...           # only to acknowledge legacy Stripe events

# ---------------------------------------------------------------------------
# Extension build (shell environment, optional)
# ---------------------------------------------------------------------------
# CF_API_BASE=https://aisidebar.netlify.app
