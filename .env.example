# ---------------------------------------------------------------------------
# Backend (Netlify → Project configuration → Environment variables)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # mark as "secret" in Netlify
GEMINI_API_KEY=...                        # Google answers (Gemini + Google Search); use a project with billing on

# Optional tuning (defaults shown)
OPENAI_MODEL_PRO=auto:smart               # newest full-size GPT; or pin a model id
OPENAI_MODEL_FREE=auto:fast               # newest GPT mini; or pin a model id
OPENAI_MODEL=gpt-5-mini,gpt-4.1-mini      # fallbacks, tried in order when a model is unavailable
OPENAI_MAX_TOKENS=1500
GEMINI_MODEL=auto                         # newest stable Gemini Flash; or pin a model id
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-flash
GEMINI_MAX_TOKENS=4096
SEARCH_FREE_DAILY_LIMIT=3                 # Google answers per install per day (part of the free 5)
SEARCH_PRO_WEEKLY_LIMIT=100               # Google answers per Pro subscription per week (part of the 375)
SEARCH_GLOBAL_DAILY_LIMIT=1500            # daily budget guard for all Google answers together
ADMIN_TOKEN=                              # long random string; enables GET /api/v2/admin/usage and the /analytics page
OWN_KEY_REPORT_DAILY_LIMIT=1000           # own-key usage reports accepted per install per day
FREE_DAILY_LIMIT=5
FREE_IP_DAILY_LIMIT=40
FREE_GLOBAL_DAILY_LIMIT=3000              # daily budget guard for all free users together
PRO_WEEKLY_LIMIT=375
APPSTORE_BUNDLE_ID=com.contextflow.app
APPSTORE_ACCEPT_SANDBOX=true              # App Review and TestFlight use sandbox purchases
ENTITLEMENT_LEEWAY_HOURS=48
STRIPE_WEBHOOK_SECRET=whsec_...           # only to acknowledge legacy Stripe events

# ---------------------------------------------------------------------------
# Extension build (shell environment, optional)
# ---------------------------------------------------------------------------
# CF_API_BASE=https://aisidebar.netlify.app
